<?xml version="1.0"?>
<!-- Obstáculo para la prueba del AEB: caja de 0.20 x 0.20 x 0.30 m (más alta que el plano del LiDAR, 0.108 m) -->
<sdf version="1.10">
  <model name="obstaculo">
    <static>true</static>
    <link name="link">
      <collision name="colision">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry><box><size>0.20 0.20 0.30</size></box></geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry><box><size>0.20 0.20 0.30</size></box></geometry>
        <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
